# ================================
# Infinite Spatial AI - .gitignore
# ================================
# Comprehensive ignore patterns to prevent accidental secret exposure
# Last Updated: 2025-01-12

# ================================
# SECRETS & CREDENTIALS (CRITICAL)
# ================================
# Never commit these files - they contain sensitive data
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.pub
*_rsa
*_rsa.pub
credentials.json
secrets.json
secrets.yaml
secrets.yml
service-account*.json
*.credentials
.aws/
.azure/
.gcloud/
firebase-adminsdk-*.json

# ================================
# PYTHON
# ================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
.venv/
venv/
ENV/
env/
.virtualenv/
env.bak/
venv.bak/
pythonenv/

# PyTorch & AI/ML
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pb
*.bin
*.h5
*.hdf5
checkpoints/
models/saved/
models/pretrained/
runs/
