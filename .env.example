# ================================
# Infinite Spatial AI - Environment Configuration Template
# ================================
# Copy this file to .env and replace ALL placeholder values
# NEVER commit .env to version control!
#
# Security Note: All CHANGE_ME_* values MUST be replaced with
# strong, randomly-generated secrets before deployment.
#
# Generate secure secrets:
#   32-char password:  openssl rand -hex 32
#   256-bit secret:    openssl rand -base64 32
#   UUID:              uuidgen
# ================================

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL credentials for main database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infinite_spatial
DB_USER=spatial_user
DB_PASSWORD=CHANGE_ME_generate_32char_password_openssl_rand_hex_32
DB_ROOT_PASSWORD=CHANGE_ME_generate_32char_password_openssl_rand_hex_32

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ================================
# SECURITY
# ================================
# JWT token secret (256-bit minimum)
JWT_SECRET=CHANGE_ME_generate_256bit_secret_openssl_rand_base64_32
JWT_EXPIRATION=24h

# Encryption key for sensitive data (256-bit)
ENCRYPTION_KEY=CHANGE_ME_generate_256bit_key_openssl_rand_base64_32

# API keys (generate unique keys per environment)
API_KEY=CHANGE_ME_generate_api_key_openssl_rand_hex_32
API_SECRET=CHANGE_ME_generate_api_secret_openssl_rand_base64_32

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ================================
# REDIS CACHE
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_never_use_default_redis_password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ================================
# VECTOR STORE (QDRANT)
# ================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME_generate_qdrant_api_key_openssl_rand_hex_32

# Collection configuration
QDRANT_COLLECTION_NAME=spatial_memory
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE_METRIC=Cosine

# ================================
# NPU CONFIGURATION (AMD XDNA 2)
# ================================
# Device path for NPU access
NPU_DEVICE=/dev/xdna
NPU_ENABLED=true

# ONNX Runtime providers (comma-separated priority order)
ONNX_PROVIDERS=VitisAIExecutionProvider,CPUExecutionProvider

# NPU performance settings
NPU_MAX_BATCH_SIZE=32
NPU_INFERENCE_THREADS=4

# ================================
# GPU CONFIGURATION
# ================================
# CUDA device selection (comma-separated for multiple GPUs)
CUDA_VISIBLE_DEVICES=0

# GPU memory allocation
GPU_MEMORY_FRACTION=0.95
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Mixed precision training
PYTORCH_ENABLE_MPS_FALLBACK=1

# ================================
# MODEL PATHS
# ================================
# Base directory for model storage
MODEL_BASE_PATH=/models

# Embedding model (384D sentence transformer)
EMBEDDING_MODEL_PATH=/models/embeddings/all-MiniLM-L6-v2

# Spatial transformer checkpoint
SPATIAL_MODEL_PATH=/models/spatial_transformer/checkpoint.pt

# Navigation network (RL model)
NAVIGATION_MODEL_PATH=/models/navigation/policy_network.pt

# ================================
# SPATIAL ENGINE CONFIGURATION
# ================================
# Spatial attention parameters
SPATIAL_RADIUS=50.0
K_NEIGHBORS=50
DECAY_RATE=0.1

# 3D space dimensions (meters)
SPACE_WIDTH=1000.0
SPACE_HEIGHT=1000.0
SPACE_DEPTH=1000.0

# Octree configuration
OCTREE_MAX_DEPTH=10
OCTREE_MIN_NODE_SIZE=10.0

# ================================
# API SERVER
# ================================
# Node.js API server
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=/api/v1

# Request limits
API_RATE_LIMIT=100
API_RATE_WINDOW=15m
API_MAX_BODY_SIZE=10mb

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# ================================
# FRONTEND
# ================================
# React development server
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_ENABLE_DEVTOOLS=true

# ================================
# PYTHON BACKEND
# ================================
# Flask/FastAPI configuration
FLASK_ENV=development
FLASK_DEBUG=false
PYTHONPATH=/home/ch1pu/infinate/backend

# Uvicorn (if using FastAPI)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=4

# ================================
# MONITORING & OBSERVABILITY
# ================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana (optional)
GRAFANA_ENABLED=false
GRAFANA_PORT=3003

# Health check endpoints
HEALTH_CHECK_INTERVAL=30s

# ================================
# DEVELOPMENT & TESTING
# ================================
# Environment mode
NODE_ENV=development
ENVIRONMENT=development

# Debug flags
DEBUG=false
VERBOSE_LOGGING=false

# Testing
TEST_DATABASE_URL=postgresql://test_user:test@localhost:5433/test_db
PYTEST_COVERAGE_THRESHOLD=90

# ================================
# DOCKER CONFIGURATION
# ================================
# Docker network names
DOCKER_NETWORK_FRONTEND=frontend-net
DOCKER_NETWORK_BACKEND=backend-net
DOCKER_NETWORK_AI=ai-net

# Volume paths
DOCKER_VOLUME_POSTGRES=/var/lib/postgresql/data
DOCKER_VOLUME_QDRANT=/qdrant/storage
DOCKER_VOLUME_REDIS=/data
DOCKER_VOLUME_MODELS=/models

# ================================
# BACKUP & DISASTER RECOVERY
# ================================
# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=CHANGE_ME_your_backup_bucket_name

# S3 credentials for backups (AWS/MinIO)
AWS_ACCESS_KEY_ID=CHANGE_ME_generate_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_generate_secret_key
AWS_REGION=us-west-2

# ================================
# OPTIONAL: EXTERNAL SERVICES
# ================================
# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry tracing (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ================================
# SECURITY HEADERS (For Production)
# ================================
# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# ================================
# END OF CONFIGURATION
# ================================
# After copying to .env, run security check:
#   grep -r "CHANGE_ME_" .env
#
# If any CHANGE_ME_ values remain, replace them before deployment!
# ================================
